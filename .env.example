# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in the real values. `.env` is gitignored.
# On Vercel, add these same keys under Settings -> Environment Variables.
#
# Only things that genuinely differ between machines/environments live here.
# The org name, phone number and timezone are constants at the top of
# server.js — edit them there.
# ---------------------------------------------------------------------------


# --- SMTP (how the mail actually gets sent) --------------------------------
# Gmail / Google Workspace. You MUST use an App Password, not your normal
# Google password: myaccount.google.com -> Security -> 2-Step Verification
# (turn it on) -> App passwords -> generate one for "Mail". It looks like
# "abcd efgh ijkl mnop" — paste it with or without the spaces.
#
# SMTP_USER doubles as the From address; Gmail rewrites anything else to it.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youraddress@gmail.com
SMTP_PASS=your-16-char-app-password

# Other providers, if you'd rather not use Gmail (pick one, same 4 keys):
#   Zoho Mail   -> smtp.zoho.com          465   your@domain.org / app password
#   Brevo       -> smtp-relay.brevo.com   587   your login / SMTP key
#   Mailgun     -> smtp.mailgun.org       587   postmaster@mg.domain / password
#   Resend      -> smtp.resend.com        587   "resend" / your API key
# Port 465 is used automatically as implicit TLS; anything else uses STARTTLS.


# --- Where submissions land -------------------------------------------------
# The inbox that receives every form submission — i.e. YOUR address. Also the
# reply-to on the confirmation the visitor receives.
CONTACT_TO_EMAIL=info@stephenstablecolorado.org


# --- Site -------------------------------------------------------------------
# Comma-separated list of sites allowed to POST to this API — the FRONTEND
# origins, not this backend's own URL. Leave blank to allow any origin (fine
# locally, not in production).
#
# Scheme + host only: the browser's Origin header carries no path and no
# trailing slash, so "https://site.com/" never matches and silently blocks
# every request. Add the custom domain here too once it's pointed at Vercel.
ALLOWED_ORIGINS=http://localhost:5173,https://stephen-table.vercel.app
