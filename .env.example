# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in the real values. `.env` is gitignored.
# On Vercel, add these same keys under Settings -> Environment Variables.
# ---------------------------------------------------------------------------


# --- SMTP (how the mail actually gets sent) --------------------------------
# Gmail / Google Workspace. You MUST use an App Password, not your normal
# Google password: myaccount.google.com -> Security -> 2-Step Verification
# (turn it on) -> App passwords -> generate one for "Mail". It looks like
# "abcd efgh ijkl mnop" — paste it with or without the spaces.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youraddress@gmail.com
SMTP_PASS=your-16-char-app-password

# Other providers, if you'd rather not use Gmail (pick one, same 4 keys):
#   Zoho Mail   -> smtp.zoho.com          465   your@domain.org / app password
#   Brevo       -> smtp-relay.brevo.com   587   your login / SMTP key
#   Mailgun     -> smtp.mailgun.org       587   postmaster@mg.domain / password
#   Resend      -> smtp.resend.com        587   "resend" / your API key
# Port 465 is used automatically as implicit TLS; anything else uses STARTTLS.


# --- Who the mail comes from and goes to -----------------------------------
# The name shown as the sender.
MAIL_FROM_NAME=Stephen's Table

# The From address. Leave blank to reuse SMTP_USER. With Gmail this must be
# SMTP_USER (or a verified "Send mail as" alias) or Google rewrites it.
MAIL_FROM_ADDRESS=youraddress@gmail.com

# The inbox that receives every form submission — i.e. YOUR address.
# This is also the reply-to on the confirmation the visitor receives.
CONTACT_TO_EMAIL=info@stephenstablecolorado.org

# Phone number printed in the visitor's confirmation email.
CONTACT_PHONE=(970) 555-0123


# --- Site / server ----------------------------------------------------------
# Comma-separated list of sites allowed to POST to this API. Leave blank to
# allow any origin (fine locally, not in production). No trailing slashes.
ALLOWED_ORIGINS=http://localhost:5173,https://stephenstablecolorado.org,https://www.stephenstablecolorado.org

# Timezone used for the "Submitted" timestamp in the email you receive.
TIMEZONE=America/Denver

# Local dev port only — Vercel sets its own and ignores this.
PORT=5000
